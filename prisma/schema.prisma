// AI Interview Coach — Prisma schema
// Source: docs/system-architecture.md §6 Data Model
// Supabase Postgres backend. Supabase Auth UUIDs bridge to User.id via webhook.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL lives in prisma.config.ts; runtime uses the driver adapter.
}

// ============================================================================
// Identity
// ============================================================================

model User {
  id                String   @id // matches Supabase auth.users.id (UUID)
  email             String   @unique
  name              String?
  image             String?
  level             Level    @default(mid)
  targetRole        String?
  targetCompanyType String?
  preferredTopics   String[] @default([])
  // CV profile — populated by the CV upload + parse feature
  cvFileUrl         String?  // Supabase Storage path: cvs/{userId}/resume.pdf (never a public URL)
  cvData            Json?    // Parsed CvData (roles, skills, projects) — see src/lib/cv/cv-types.ts
  cvParsedAt        DateTime? // Timestamp of last successful LLM parse
  // Interview preparation target date — optional countdown shown on dashboard
  targetInterviewDate DateTime?
  // Subscription
  isPro               Boolean   @default(false)
  hasLifetimePlan     Boolean   @default(false) // true = lifetime order.paid; protected from subscription cancellation
  polarCustomerId     String?   @unique
  polarSubscriptionId String?   @unique
  proSince            DateTime?
  // proExpiresAt is set only for promo-granted access; null = permanent (Polar subscriber)
  proExpiresAt        DateTime?
  // Daily practice loop — spaced repetition schedule + streak
  dailyGoal           Int       @default(3)  // target reviews per day
  currentStreak       Int       @default(0)
  longestStreak       Int       @default(0)
  lastActiveDate      DateTime?              // UTC date of last review activity (streak bookkeeping)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions          InterviewSession[]
  studyPlan         StudyPlan?
  redemptions       PromoRedemption[]
  targetJobs        TargetJob[]
  codingSubmissions CodingSubmission[]
  reviewItems       ReviewItem[]
}

// ============================================================================
// Promo codes — admin-issued codes that grant timed Pro access
// ============================================================================

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique  // e.g. "LAUNCH7", "BETA30" — stored UPPERCASE
  durationDays Int                // days of Pro access granted on redemption
  // maxUses = 0 means unlimited
  maxUses      Int       @default(0)
  usedCount    Int       @default(0)
  expiresAt    DateTime?           // null = code itself never expires
  note         String?             // admin memo
  createdAt    DateTime  @default(now())

  redemptions PromoRedemption[]
}

model PromoRedemption {
  id           String    @id @default(cuid())
  promoCodeId  String
  userId       String
  grantedAt    DateTime  @default(now())
  proExpiresAt DateTime             // grantedAt + durationDays

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])  // one redemption per code per user
}

// ============================================================================
// Interview lifecycle
// ============================================================================

model InterviewSession {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode         SessionMode
  topics       String[]
  difficulty   Difficulty
  status       SessionStatus @default(in_progress)
  overallScore Float?
  usesCv       Boolean       @default(false) // true when session was started with CV-grounded mode
  // Job targeting (Pro) — label copied from TargetJob.label at session creation
  label        String?
  targetJobId  String?
  targetJob    TargetJob?    @relation(fields: [targetJobId], references: [id], onDelete: SetNull)
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
  shareToken   String?       @unique

  questions InterviewQuestion[]
  summary   SessionSummary?

  @@index([userId, startedAt])
}

// ============================================================================
// Job targeting (Pro) — saved JD profiles for tailored question generation
// ============================================================================

model TargetJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   // user-set name: "Stripe Senior FE"
  rawJd     String   @db.Text
  jdContext Json?    // extracted: { role, company?, level?, domain, requiredStack[], signals[] }
  createdAt DateTime @default(now())

  sessions  InterviewSession[]

  @@index([userId])
}

model InterviewQuestion {
  id             String       @id @default(cuid())
  sessionId      String
  session        InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topic          String
  subtopic       String?
  difficulty     Difficulty
  type           QuestionType
  question       String       @db.Text
  expectedPoints String[]
  order          Int
  seedQuestionId String?

  answer UserAnswer?

  @@index([sessionId, order])
}

model UserAnswer {
  id             String   @id @default(cuid())
  questionId     String   @unique
  question       InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sessionId      String
  userId         String
  answer         String   @db.Text
  followUpAnswer String?  @db.Text
  createdAt      DateTime @default(now())

  feedback AnswerFeedback?

  @@index([userId, createdAt])
}

model AnswerFeedback {
  id       String     @id @default(cuid())
  answerId String     @unique
  answer   UserAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  overallScore          Float
  scoreCorrectness      Int
  scoreCompleteness     Int
  scoreClarity          Int
  scoreDepth            Int
  scoreTradeoffThinking Int
  scoreCommunication    Int

  whatWentWell            String[]
  whatWasMissing          String[]
  technicalCorrections    String[]
  improvementSuggestions  String[]
  betterAnswer            String   @db.Text
  seniorLevelAddition     String?  @db.Text
  recommendedNextPractice String[]

  // Telemetry
  modelUsed   String
  tokensUsed  Int
  createdAt   DateTime @default(now())
}

// ============================================================================
// Spaced repetition — one row per (user, topic). Advanced by every scored answer
// (see review-scheduler-service); the /review flow resurfaces due topics.
// ============================================================================

model ReviewItem {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic          String
  // SM-2-lite scheduling state
  easeFactor     Float       @default(2.5) // clamped 1.3 .. 2.5
  intervalDays   Int         @default(0)
  repetitions    Int         @default(0)
  dueAt          DateTime    @default(now())
  lastScore      Float?                    // last answer overallScore (1..5), for weak-area ordering
  lastDifficulty Difficulty?               // informs difficulty when regenerating a question
  lastReviewedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([userId, topic])
  @@index([userId, dueAt])
}

model SessionSummary {
  id                String           @id @default(cuid())
  sessionId         String           @unique
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore      Float
  strongAreas       String[]
  weakAreas         String[]
  repeatedMistakes  String[]
  recommendedTopics String[]
  actionItems       String[]
  createdAt         DateTime @default(now())
}

// ============================================================================
// Seed bank (PRD §7.10) — content extracted from resources/*.html, EN-only.
// ============================================================================

model SeedQuestion {
  id             String       @id
  topic          String
  subtopic       String?
  difficulty     Difficulty
  type           QuestionType
  question       String       @db.Text
  expectedPoints String[]
  followUps      String[]
  rubric         Json
  tags           String[]     @default([]) // e.g. ["web3"]
  sourceFile     String?      // provenance: which resources/*.html
  // URL slug for public /questions/[slug] pages. Assigned once (backfill or
  // first seed insert) and never recomputed when question text is edited —
  // URL permanence beats slug freshness.
  slug           String?      @unique

  // Study content — populated from source HTML or AI generation.
  // childExplanation: plain-text ELI5 paragraph(s), EN.
  // detailedExplanation: translated body HTML (h4, p, ul, code, pre), EN.
  // diagramSvg: <svg>…</svg> string (rendered from spec or hand-crafted, priority).
  // diagramMermaid: legacy Mermaid source kept for backward-compat (fallback if no SVG).
  // quiz: JSON-serialised QuizData for the end-of-card interactive quick-check.
  childExplanation    String?  @db.Text
  detailedExplanation String?  @db.Text
  diagramSvg          String?  @db.Text
  diagramMermaid      String?  @db.Text
  quiz                String?  @db.Text

  createdAt      DateTime     @default(now())

  @@index([topic, difficulty])
}

// ============================================================================
// Study plan
// ============================================================================

model StudyPlan {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Topics the user wants to focus on (subset of CANONICAL_TOPICS).
  topics    String[]
  // Target interview level — drives which difficulty band of questions is served.
  level     Level
  // Preparation window in weeks (1 | 2 | 4 | 12).
  prepWeeks Int
  startedAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  progress  StudyPlanProgress[]

  @@index([userId])
}

// Tracks which seed questions the user has marked as studied.
// One row per (plan, question) pair — upserted when user taps "Mark as studied".
// SM-2 fields drive the spaced-repetition review schedule.
model StudyPlanProgress {
  id             String    @id @default(cuid())
  planId         String
  plan           StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId         String
  seedQuestionId String
  studiedAt      DateTime  @default(now())
  // SM-2 spaced repetition state
  repetitions    Int       @default(0)
  interval       Int       @default(1)    // days until next review
  easeFactor     Float     @default(2.5)
  nextReviewAt   DateTime?               // null until first review computed

  @@unique([planId, seedQuestionId])
  @@index([userId])
  @@index([planId, nextReviewAt])
}

// ============================================================================
// Cost & observability
// ============================================================================

model AICall {
  id               String   @id @default(cuid())
  userId           String?
  sessionId        String?
  task             String   // 'generate_question' | 'evaluate_answer' | ...
  model            String
  promptTokens     Int
  completionTokens Int
  costUsd          Decimal  @db.Decimal(10, 6)
  latencyMs        Int
  succeeded        Boolean
  errorReason      String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([task, createdAt])
}

// ============================================================================
// Enums
// ============================================================================

enum Level {
  junior
  mid
  senior
  staff
}

enum Difficulty {
  junior
  mid
  senior
}

enum SessionMode {
  quick
  standard
  deep_coaching
  // Exam-simulation: no live feedback during the session; all scoring revealed
  // together at the end. Pro-only.
  mock
}

enum SessionStatus {
  in_progress
  completed
  ended_early
}

enum QuestionType {
  conceptual
  coding
  debugging
  system_design
  behavioral
  tradeoff
}

// ============================================================================
// Coding Challenges
// ============================================================================

model CodingChallenge {
  id          String     @id
  title       String
  description String     @db.Text
  difficulty  Difficulty
  topic       String
  tags        String[]
  // 'function' = classic JS challenge run in the Node vm executor.
  // 'component' = React UI challenge built + graded client-side (axe-core a11y,
  // live render) in a sandboxed iframe. For 'component', `testCases` holds the
  // component spec { componentName } and `starterCode`/`solution` are JSX.
  kind        String     @default("function")
  starterCode String     @db.Text
  testCases   Json
  hints       Json       @default("[]")
  solution    String     @db.Text
  timeLimit   Int        @default(5000)
  createdAt   DateTime   @default(now())

  submissions CodingSubmission[]

  @@index([difficulty])
  @@index([topic])
}

model CodingSubmission {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   CodingChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  code        String          @db.Text
  language    String          @default("javascript")
  status      String
  testResults Json
  passedCount Int
  totalCount  Int
  executionMs Int?
  aiReview    String?         @db.Text
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([challengeId])
}
